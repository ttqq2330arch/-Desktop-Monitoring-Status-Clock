{
  "_说明": "把本文件复制为 printers.json（同目录）并填入你自己的值。printers.json 含凭据，已被 .gitignore 排除，不会进仓库。",
  "_printer1": "第 1 台打印机 → 设备端第 4 页（VIEW_PRINTER1）",
  "_printer2": "第 2 台打印机 → 设备端第 5 页（VIEW_PRINTER2）",

  "printer1": {
    "enabled": true,
    "type": "creality_moonraker",
    "name": "Creality",
    "ip": "192.168.1.100",
    "port": 7125,
    "api_key": ""
  },

  "printer2": {
    "enabled": true,
    "type": "anycubic_lan",
    "name": "Kobra X",
    "ip": "192.168.1.50",
    "_说明2": "纵维立方须先在打印机屏幕上开启「局域网模式」（开一次即持久生效）。凭据免配置：程序启动自动从打印机 :18910 接口发现，无需填任何账号密码。进度由打印机事件推送（约 1 分钟一次），温度/状态每 30 秒主动查询一次。详见 docs/纵维立方局域网接入指南.md。"
  }
}
